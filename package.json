{
  "name": "nexus-spotlight",
  "version": "0.1.0",
  "type": "module",
  "description": "Ultra-sleek Mac Spotlight style Floating AI search and command bar",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "vite",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "typecheck": "tsc --noEmit",
    "build:ci": "tsc && vite build",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^34.2.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}

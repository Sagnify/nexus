# Groq API Key (required)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Configurations
GROQ_FAST_MODEL=groq/compound-mini
GROQ_REASONING_MODEL=groq/compound
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TOOL_MODEL=groq/compound

# Spotify OAuth (public Client ID; PKCE means no client secret is required)
# Register http://127.0.0.1:8000/api/connectors/spotify/callback in your Spotify app.
SPOTIFY_CLIENT_ID=

# Database & Embeddings (optional)
POSTGRES_URL=
EMBEDDING_MODEL=all-minilm
